# Copie este arquivo para terraform.tfvars e ajuste os valores.
# NUNCA commite terraform.tfvars no Git — ele está no .gitignore.

aws_region        = "us-east-1"
project           = "togglemaster"
eks_node_type     = "t3.medium"
eks_desired_nodes = 2
eks_min_nodes     = 1
eks_max_nodes     = 3
github_repo       = "lcsbm/togglemaster-fase4"
